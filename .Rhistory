#=========================================================
#Project: Hierarchical reinforcement learning
#script: 01_explore_data.R
#Purpose: Explore trial-level behavioral data
#Data source: Ben-Artzi et al. (2023)
#DOI: 10.5061/dryad.d51c5b08d
#=========================================================
rm(list=ls())
data_dir <- 'Data/df_raw.csv'
data <- read.csv(data_dir)
head(data)
#examine structure
str(data)
names(data)
dim(data)
summary(data)
nSubjects <- length(unique(data$subj))
table(data$rw, useNA='ifany')
table(data$cond)
subject_id<-unique(data$subj)[1]
sub01<-subset(data,subj==subject_id)
sub01<-sub01[order(sub01$blk,sub01$trl),]
head(sub01)
View(sub01)
hist(
data$rt,
main='distribution of reaction times',
xlab='reaction times(ms)'
)
barplot(
table(data$ch),
main='frequency of card choices',
xlab='the card',
ylab='number of choices'
)
##We have to fix the card identities starting from 0 instead of 1
rm(list=ls())
data_dir <- 'Data/df_raw.csv'
data <- read.csv(data_dir)
/RR
view(data)
View(data)
View(data)
?ifelse
rm(list=ls())
data_dir <- 'Data/df_raw.csv'
data <- read.csv(data_dir)
#extract one subject
subject_id<-unique(data$subj)[1]
sub01<-subset(data,subj==subject_id)
sub01<-sub01[order(sub01$blk,sub01$trl),]
##prepare data of that one subject
#keep valid card identities for inspection (frcA and frcB are the identity IDs of those cards)
sub01$card_left <- sub01$frcA + 1
sub01$card_right <- sub01$frcB + 1
sub01$chosen_card <- sub01$ch + 1
#binary choice: left = 0, right = 1
# ifelse is vectorized and it's Conditional Element Selection
sub01$choice <- ifelse(
sub01$ch == sub01$frcB, 1,
ifelse(sub01$ch == sub01$frcA, 0, NA)
)
